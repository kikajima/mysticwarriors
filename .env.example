# Produção (Render): use o Session Pooler do Supabase, porta 5432.
# Acrescente schema=game e sslmode=require. Percent-encode caracteres
# reservados da senha antes de montar a URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=game&sslmode=require

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública canônica do site (SEO/robots/sitemap).
NEXT_PUBLIC_SITE_URL=https://seu-dominio.example

# SEGREDO SERVER-SIDE opcional para /api/admin/db-export.
# Gere valor aleatório forte (>= 32 bytes) e configure SOMENTE no Render.
# Nunca prefixe com NEXT_PUBLIC_ e nunca versione o valor real.
GM_ADMIN_EXPORT_SECRET=
