# Desenvolvimento local: ajuste o caminho conforme sua máquina.
# Render: use o arquivo dentro do Persistent Disk, por exemplo:
# DATABASE_URL=file:/var/data/custom.db
DATABASE_URL=file:/var/data/custom.db

ADMIN_EMAIL=configure-o-email-do-administrador
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente para PRIMEIRO boot de uma instalação nova e vazia.
# Nunca habilite ao migrar um serviço que já possui jogadores.
ALLOW_EMPTY_DB_INIT=false
